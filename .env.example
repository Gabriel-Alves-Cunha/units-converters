# Production must use the live site origin (canonicals, OG, sitemap).
VITE_BASE_URL=https://units-converters.com

# Optional: PostHog analytics (only loads after cookie accept)
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# AdSense display unit IDs (create in AdSense console, then set these)
# VITE_ADSENSE_SLOT_GUIDE=
# VITE_ADSENSE_SLOT_CATEGORY=
# VITE_ADSENSE_SLOT_CONVERSION_DETAILS=
# VITE_ADSENSE_SLOT_CONVERT=

# Optional company identity for Contact / trust pages (do not invent values)
# VITE_COMPANY_CNPJ=
# VITE_COMPANY_ADDRESS=

# Optional Media.net site ID (loads only after cookie accept; AdSense-like backup)
# VITE_MEDIANET_SITE_ID=

# Optional Amazon Associates tag for guide affiliate CTAs (disclosure on Disclaimer)
# VITE_AMAZON_ASSOCIATE_TAG=

# AdSense reapply checklist (manual — not env vars):
# 1) Confirm https://units-converters.com/ads.txt serves the Google line
# 2) Submit the English home URL for review after 2–4 weeks of stable content
# 3) Close any duplicate AdSense publisher accounts first
# 4) Use only organic traffic — never paid-to-click or purchased visits
