msgid "Is 100 on the sign mph or km/h?"
msgstr ""

#: src/features/guides/data/guides.ts:2207
msgid "Is 12.5 stone the same as 12 st 5 lb?"
msgstr ""

#: src/features/guides/data/guides.ts:1599
msgid "Is 23 kg the same as 50 lb for airline bags?"
msgstr ""

#: src/features/guides/data/guides.ts:1465
msgid "Is a 5K race five kilometres or five miles?"
msgstr "¿Una carrera de 5 km es cinco kilómetros o cinco millas?"

#: src/features/guides/data/guides.ts:1978
msgid "Is a Julian year the same as a leap year?"
msgstr ""

#: src/features/guides/data/guides.ts:1828
msgid "Is a knot the same as a mph?"
msgstr ""

#: src/features/guides/data/guides.ts:698
msgid "Is a light-year a measure of time?"
msgstr "¿Es un año luz una medida de tiempo?"

#: src/features/guides/data/guides.ts:552
msgid "Is a metre longer than a yard?"
msgstr "¿Es un metro más largo que una yarda?"

#: src/features/guides/data/guides.ts:778
msgid "Is a micron the same as a micrometre?"
msgstr "¿Es lo mismo una micra que un micrómetro?"

#: src/features/guides/data/guides.ts:631
msgid "Is an acre-foot an area unit?"
msgstr "¿Es un acre-pie una unidad de área?"

#: src/features/guides/data/guides.ts:473
msgid "Is centi used as widely as milli and kilo?"
msgstr "¿Se utilizan centi tan ampliamente como mili y kilo?"

#: src/features/guides/data/guides.ts:2424
msgid "Is density a unit you can convert like kilometres?"
