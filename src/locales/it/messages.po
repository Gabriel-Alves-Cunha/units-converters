msgid "unit converter, metric conversion, imperial to metric, length converter, temperature converter, area converter, volume converter, scientific calculator"
msgstr "convertitore di unità, conversione metrica, convertitore da imperiale a metrico, convertitore di lunghezza, convertitore di temperatura, convertitore di area, convertitore di volume, calcolatrice scientifica"

