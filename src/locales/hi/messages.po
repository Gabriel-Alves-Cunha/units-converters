msgid "Light Day"
msgstr "प्रकाश दिवस"

#: src/lib/units.ts:1191
msgid "Light Hour"
msgstr "प्रकाश घंटा"

#: src/lib/units.ts:1192
msgid "Light Minute"
msgstr "प्रकाश मिनट"

#: src/lib/units.ts:1193
