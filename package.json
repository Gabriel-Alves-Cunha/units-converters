{
	"name": "units-converters",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"lint:all": "bun run format && bun run lint && bun run typecheck && bunx lingui extract && bunx lingui compile --typescript",
		"generate:sitemap": "bunx vite-node --config vite.config.ts --mode production scripts/generate-sitemap.ts",
		"build": "bun run generate:sitemap && bunx lingui extract-template && bunx lingui compile --typescript && vite build",
		"deploy": "bun run build && wrangler deploy",
		"dev": "portless units-converters vite dev",
		"preview": "bun run build && wrangler dev",
		"cf-typegen": "wrangler types",
		"format": "oxfmt --write",
		"typecheck": "tsc",
		"lint": "oxlint"
	},
	"dependencies": {
		"@emailjs/browser": "^4.4.1",
		"@lingui/react": "^6.5.0",
		"@lingui/swc-plugin": "^6.5.1",
		"@lingui/vite-plugin": "^6.5.0",
		"@posthog/react": "^1.10.3",
		"@tailwindcss/vite": "^4.3.2",
		"@tanstack/react-devtools": "^0.10.8",
		"@tanstack/react-router": "^1.170.17",
		"@tanstack/react-router-devtools": "^1.167.0",
		"@tanstack/react-start": "^1.168.27",
		"@tanstack/router-plugin": "^1.168.19",
		"@vitejs/plugin-react-swc": "^4.3.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"decimal.js": "^10.6.0",
		"lucide-react": "^1.24.0",
		"posthog-js": "^1.399.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-error-boundary": "^6.1.2",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.2",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.44.0",
		"@rsbuild/core": "^2.1.5",
		"@tanstack/devtools-vite": "^0.8.1",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"type-fest": "^5.8.0",
		"typescript": "^7.0.2",
		"vite": "^8.1.4",
		"wrangler": "^4.110.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	}
}
